*.pt
*.pth
*.ckpt
*.zip
*.tar
*.tar.gz

# Python / notebooks
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
venv/
.venv/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
